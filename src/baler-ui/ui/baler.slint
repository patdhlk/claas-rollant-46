// SPDX-License-Identifier: GPL-3.0-only
// Pure view for the CR1140 baler controller (800x480, no touch). All state is
// fed from Rust via exported properties; all logic (screen switching, PIN,
// command dispatch) lives in main.rs. The .slint side never reads input — the
// keypad is handled as a custom model in Rust, not via Slint key dispatch.

// Screen selector, driven from Rust. Mirrors the Rust `Nav` enum by index.
export enum Screen { main, service, ethernet, fault, iotest }

/// All language-dependent labels, mirroring `i18n::Strings`. Slint maps '-' to
/// '_' in the generated Rust type. Set as a whole from Rust each frame from the
/// active language's table (ISSUE_0005-0008). The IO-test page is a technician
/// screen and stays English, so it is not represented here.
export struct I18n {
    // Main
    title: string,
    bale-full-banner: string,
    session-caption: string,
    total-caption: string,
    knife-caption: string,
    sk-wrap: string,
    sk-wrapping: string,
    sk-knife-toggle: string,
    sk-knife-active: string,
    sk-reset-session: string,
    sk-service: string,
    // Service
    service-title: string,
    enter-pin: string,
    pin-hint: string,
    network-caption: string,
    sk-reset-total: string,
    sk-use-ethernet: string,
    sk-use-ethercat: string,
    sk-io-test: string,
    sk-language: string,
    sk-back: string,
    // Ethernet
    eth-title: string,
    eth-offline: string,
    static-ip-caption: string,
    sk-return-ethercat: string,
    // Fault
    fault-title: string,
    fault-detail: string,
    fault-hint: string,
}

global Theme {
    out property <color> bg: #0e1116;
    out property <color> panel: #1b2230;
    out property <color> panel-edge: #2c3647;
    out property <color> text: #e6edf3;
    out property <color> muted: #8b98a8;
    out property <color> accent: #3da5ff;
    out property <color> ok: #38c172;
    out property <color> warn: #f5a623;
    out property <color> danger: #e5484d;
    out property <color> armed: #ffd23f;
}

component Softkey inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> enabled: true;
    in property <bool> highlighted: false;
    width: 126px;
    height: 56px;
    border-radius: 6px;
    border-width: highlighted ? 2px : 1px;
    border-color: highlighted ? Theme.armed : Theme.panel-edge;
    background: highlighted
        ? Theme.armed.with-alpha(0.18)
        : (enabled ? Theme.panel : Theme.panel.with-alpha(0.4));
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        Text {
            text: root.key;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.text : Theme.muted;
            font-size: 16px;
            font-weight: root.highlighted ? 800 : 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component StatTile inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <color> value-color: Theme.text;
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.panel-edge;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.caption; color: Theme.muted; font-size: 14px; }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 34px;
            font-weight: 800;
        }
    }
}

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    background: Theme.bg;
    default-font-size: 16px;

    // ---- inputs from StateSnapshot -------------------------------------
    in property <Screen> screen: Screen.main;
    // Active-language labels, set as a whole from Rust (ISSUE_0005-0008).
    in property <I18n> tr;
    in property <string> mode-text: "INITIALISING";
    in property <bool> bale-full: false;
    in property <string> knife-text: "UNKNOWN";
    in property <bool> wrap-armed: false;
    in property <bool> wrap-active: false;
    in property <bool> knife-active: false;
    in property <string> session-text: "0";
    in property <string> total-text: "0";
    in property <bool> ethercat-healthy: false;
    in property <string> ip-text: "—";
    in property <string> pin-display: "____";
    in property <bool> ethernet-selected: false;
    in property <string> fault-text: "ETHERCAT LINK LOST";
    // IO test screen (REQ_0018): live raw inputs + currently-driven outputs.
    in property <bool> di1: false;
    in property <bool> di2: false;
    in property <bool> out-wrap: false;
    in property <bool> out-knives-in: false;
    in property <bool> out-knives-out: false;

    // Force the software renderer to embed the German umlaut + ß glyphs. Slint
    // only subsets glyphs it finds in .slint string literals, but the German
    // labels come from Rust at runtime — so without this hidden anchor ö/ä/ü/ß
    // render as blanks (ISSUE_0013).
    Text { text: "ÄÖÜäöüß"; visible: false; }

    // =====================================================================
    // MAIN
    // =====================================================================
    if root.screen == Screen.main: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.tr.title;
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Rectangle { }
                Rectangle {
                    width: 220px;
                    border-radius: 6px;
                    background: root.ethercat-healthy
                        ? Theme.ok.with-alpha(0.18)
                        : Theme.danger.with-alpha(0.22);
                    border-width: 1px;
                    border-color: root.ethercat-healthy ? Theme.ok : Theme.danger;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 12px; height: 12px;
                            y: parent.height / 2 - 6px;
                            border-radius: 6px;
                            background: root.ethercat-healthy ? Theme.ok : Theme.danger;
                        }
                        Text {
                            text: root.mode-text;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 64px;
                border-radius: 8px;
                visible: root.bale-full;
                background: Theme.warn;
                Text {
                    text: root.tr.bale-full-banner;
                    color: #1a1300;
                    font-size: 28px;
                    font-weight: 800;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                StatTile {
                    caption: root.tr.session-caption;
                    value: root.session-text;
                    horizontal-stretch: 1;
                }
                StatTile {
                    caption: root.tr.total-caption;
                    value: root.total-text;
                    horizontal-stretch: 1;
                }
                StatTile {
                    caption: root.tr.knife-caption;
                    value: root.knife-text;
                    value-color: root.knife-active ? Theme.accent : Theme.text;
                    horizontal-stretch: 1;
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey {
                    key: "F1";
                    label: root.wrap-active ? root.tr.sk-wrapping : root.tr.sk-wrap;
                    // Always enabled like F2 — firing a wrap is the operator's
                    // responsibility; `wrap-armed` is just an advisory highlight (REQ_0013).
                    highlighted: root.wrap-armed;
                }
                Softkey {
                    key: "F2";
                    label: root.knife-active ? root.tr.sk-knife-active : root.tr.sk-knife-toggle;
                }
                Softkey { key: "F3"; label: root.tr.sk-reset-session; }
                Softkey { key: "F4"; label: ""; enabled: false; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: root.tr.sk-service; }
            }
        }
    }

    // =====================================================================
    // SERVICE
    // =====================================================================
    if root.screen == Screen.service: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: root.tr.service-title; color: Theme.text; font-size: 26px; font-weight: 800; }

            Rectangle {
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.panel-edge;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: root.tr.enter-pin; color: Theme.muted; font-size: 16px; }
                    Text {
                        text: root.pin-display;
                        color: Theme.text;
                        font-size: 48px;
                        font-weight: 800;
                        letter-spacing: 12px;
                    }
                    Text {
                        text: root.tr.pin-hint;
                        color: Theme.muted;
                        font-size: 14px;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: root.ethernet-selected ? Theme.panel : Theme.accent.with-alpha(0.18);
                    border-width: 1px;
                    border-color: root.ethernet-selected ? Theme.panel-edge : Theme.accent;
                    VerticalLayout {
                        padding: 12px;
                        Text { text: root.tr.network-caption; color: Theme.muted; font-size: 13px; }
                        Text {
                            text: root.ethernet-selected ? "ETHERNET" : "ETHERCAT";
                            color: Theme.text; font-size: 22px; font-weight: 700;
                        }
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey { key: "F1"; label: root.tr.sk-reset-total; }
                Softkey { key: "F2"; label: root.ethernet-selected ? root.tr.sk-use-ethercat : root.tr.sk-use-ethernet; }
                Softkey { key: "F3"; label: root.tr.sk-io-test; }
                Softkey { key: "F4"; label: root.tr.sk-language; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: root.tr.sk-back; }
            }
        }
    }

    // =====================================================================
    // ETHERNET
    // =====================================================================
    if root.screen == Screen.ethernet: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: root.tr.eth-title; color: Theme.accent; font-size: 26px; font-weight: 800; }

            Rectangle {
                height: 64px;
                border-radius: 8px;
                background: Theme.accent.with-alpha(0.15);
                border-width: 1px;
                border-color: Theme.accent;
                Text {
                    text: root.tr.eth-offline;
                    color: Theme.text; font-size: 22px; font-weight: 700;
                }
            }

            Rectangle {
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.panel-edge;
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text { text: root.tr.static-ip-caption; color: Theme.muted; font-size: 16px; }
                    Text { text: root.ip-text; color: Theme.text; font-size: 40px; font-weight: 800; }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey { key: "F1"; label: root.tr.sk-return-ethercat; }
                Softkey { key: "F2"; label: ""; enabled: false; }
                Softkey { key: "F3"; label: ""; enabled: false; }
                Softkey { key: "F4"; label: ""; enabled: false; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: ""; enabled: false; }
            }
        }
    }

    // =====================================================================
    // FAULT overlay (modal)
    // =====================================================================
    if root.screen == Screen.fault: Rectangle {
        background: #000000.with-alpha(0.78);
        Rectangle {
            width: 560px;
            height: 280px;
            border-radius: 12px;
            background: Theme.panel;
            border-width: 3px;
            border-color: Theme.danger;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: center;
                Text {
                    text: root.tr.fault-title;
                    color: Theme.danger;
                    font-size: 44px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.fault-text;
                    color: Theme.text;
                    font-size: 22px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.tr.fault-detail;
                    color: Theme.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.tr.fault-hint;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // =====================================================================
    // IO TEST (REQ_0018) — momentary outputs, live inputs
    // =====================================================================
    if root.screen == Screen.iotest: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: "IO TEST"; color: Theme.accent; font-size: 26px; font-weight: 800; }

            // Outputs (driven while the F-key is held).
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    border-radius: 8px;
                    background: root.out-wrap ? Theme.accent : Theme.panel;
                    border-width: 1px;
                    border-color: root.out-wrap ? Theme.accent : Theme.panel-edge;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: "DO1 WRAP (hold F1)"; color: Theme.muted; font-size: 15px; }
                        Text { text: root.out-wrap ? "ENERGISED" : "off"; color: Theme.text; font-size: 30px; font-weight: 800; }
                    }
                }
                Rectangle {
                    border-radius: 8px;
                    background: root.out-knives-in ? Theme.accent : Theme.panel;
                    border-width: 1px;
                    border-color: root.out-knives-in ? Theme.accent : Theme.panel-edge;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: "DO2 KNIVES IN (hold F2)"; color: Theme.muted; font-size: 15px; }
                        Text { text: root.out-knives-in ? "ENERGISED" : "off"; color: Theme.text; font-size: 30px; font-weight: 800; }
                    }
                }
                Rectangle {
                    border-radius: 8px;
                    background: root.out-knives-out ? Theme.accent : Theme.panel;
                    border-width: 1px;
                    border-color: root.out-knives-out ? Theme.accent : Theme.panel-edge;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: "DO3 KNIVES OUT (hold F3)"; color: Theme.muted; font-size: 15px; }
                        Text { text: root.out-knives-out ? "ENERGISED" : "off"; color: Theme.text; font-size: 30px; font-weight: 800; }
                    }
                }
            }

            // Inputs (live, un-debounced).
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: root.di1 ? Theme.accent : Theme.panel-edge;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: "DI1 BALE FULL"; color: Theme.muted; font-size: 15px; }
                        Text { text: root.di1 ? "TRUE" : "false"; color: root.di1 ? Theme.accent : Theme.text; font-size: 30px; font-weight: 800; }
                    }
                }
                Rectangle {
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: root.di2 ? Theme.accent : Theme.panel-edge;
                    VerticalLayout {
                        padding: 14px; spacing: 6px;
                        Text { text: "DI2 KNIFE IN"; color: Theme.muted; font-size: 15px; }
                        Text { text: root.di2 ? "TRUE" : "false"; color: root.di2 ? Theme.accent : Theme.text; font-size: 30px; font-weight: 800; }
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey { key: "F1"; label: "HOLD = WRAP"; }
                Softkey { key: "F2"; label: "HOLD = KN IN"; }
                Softkey { key: "F3"; label: "HOLD = KN OUT"; }
                Softkey { key: "F4"; label: ""; enabled: false; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: "EXIT"; }
            }
        }
    }
}
