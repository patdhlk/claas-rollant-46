// SPDX-License-Identifier: GPL-3.0-only
// Pure view for the CR1140 baler controller (800x480, no touch). All state is
// fed from Rust via exported properties; all logic (screen switching, PIN,
// command dispatch) lives in main.rs. The .slint side never reads input — the
// keypad is handled as a custom model in Rust, not via Slint key dispatch.

// Screen selector, driven from Rust. Mirrors the Rust `Nav` enum by index.
export enum Screen { main, service, ethernet, fault }

/// All static UI labels for one language, mirroring i18n::Strings.
/// Field names use kebab-case; Slint maps '-' to '_' in the generated Rust type
/// so `bale-full-banner` → Rust field `bale_full_banner`.
export struct I18n {
    // Main screen
    title: string,
    bale-full-banner: string,
    session-caption: string,
    total-caption: string,
    knife-caption: string,
    sk-wrap: string,
    sk-wrapping: string,
    sk-knife-toggle: string,
    sk-knife-active: string,
    sk-reset-session: string,
    sk-service: string,

    // Service screen
    service-title: string,
    enter-pin: string,
    pin-hint: string,
    network-caption: string,
    sk-reset-total: string,
    sk-use-ethernet: string,
    sk-use-ethercat: string,
    sk-back: string,

    // Ethernet screen
    eth-title: string,
    eth-offline: string,
    static-ip-caption: string,
    sk-return-ethercat: string,

    // Fault screen
    fault-title: string,
    fault-detail: string,

    // Language toggle label: the TARGET language's endonym (shown on service F3)
    sk-language: string,
}

global Theme {
    out property <color> bg: #0e1116;
    out property <color> panel: #1b2230;
    out property <color> panel-edge: #2c3647;
    out property <color> text: #e6edf3;
    out property <color> muted: #8b98a8;
    out property <color> accent: #3da5ff;
    out property <color> ok: #38c172;
    out property <color> warn: #f5a623;
    out property <color> danger: #e5484d;
    out property <color> armed: #ffd23f;
}

component Softkey inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <bool> enabled: true;
    in property <bool> highlighted: false;
    width: 126px;
    height: 56px;
    border-radius: 6px;
    border-width: highlighted ? 2px : 1px;
    border-color: highlighted ? Theme.armed : Theme.panel-edge;
    background: highlighted
        ? Theme.armed.with-alpha(0.18)
        : (enabled ? Theme.panel : Theme.panel.with-alpha(0.4));
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        Text {
            text: root.key;
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.text : Theme.muted;
            font-size: 16px;
            font-weight: root.highlighted ? 800 : 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component StatTile inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <color> value-color: Theme.text;
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.panel-edge;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.caption; color: Theme.muted; font-size: 14px; }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 34px;
            font-weight: 800;
        }
    }
}

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    background: Theme.bg;
    default-font-size: 16px;

    // ---- i18n string table (set from Rust via set_tr) ----------------------
    in property <I18n> tr;

    // ---- inputs from StateSnapshot -------------------------------------
    in property <Screen> screen: Screen.main;
    // mode/knife/fault text are language-aware and always set from Rust via
    // push_view before the first draw; defaults stay blank so no untranslated
    // literal lives in the view (the i18n table is the sole source of truth).
    in property <string> mode-text;
    in property <bool> bale-full: false;
    in property <string> knife-text;
    in property <bool> wrap-armed: false;
    in property <bool> wrap-active: false;
    in property <bool> knife-active: false;
    in property <string> session-text: "0";
    in property <string> total-text: "0";
    in property <bool> ethercat-healthy: false;
    in property <string> ip-text: "—";
    in property <string> pin-display: "____";
    in property <bool> ethernet-selected: false;
    in property <string> fault-text;

    // Glyph anchor: forces the EmbedForSoftwareRenderer font pass to embed
    // German umlaut and ß glyphs, which otherwise never appear in .slint
    // literals (the German strings live in Rust). Keep visible: false.
    Text { text: "ÄÖÜäöüß"; visible: false; }

    // =====================================================================
    // MAIN
    // =====================================================================
    if root.screen == Screen.main: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.tr.title;
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Rectangle { }
                Rectangle {
                    width: 220px;
                    border-radius: 6px;
                    background: root.ethercat-healthy
                        ? Theme.ok.with-alpha(0.18)
                        : Theme.danger.with-alpha(0.22);
                    border-width: 1px;
                    border-color: root.ethercat-healthy ? Theme.ok : Theme.danger;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 12px; height: 12px;
                            y: parent.height / 2 - 6px;
                            border-radius: 6px;
                            background: root.ethercat-healthy ? Theme.ok : Theme.danger;
                        }
                        Text {
                            text: root.mode-text;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 64px;
                border-radius: 8px;
                visible: root.bale-full;
                background: Theme.warn;
                Text {
                    text: root.tr.bale-full-banner;
                    color: #1a1300;
                    font-size: 28px;
                    font-weight: 800;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                StatTile {
                    caption: root.tr.session-caption;
                    value: root.session-text;
                    horizontal-stretch: 1;
                }
                StatTile {
                    caption: root.tr.total-caption;
                    value: root.total-text;
                    horizontal-stretch: 1;
                }
                StatTile {
                    caption: root.tr.knife-caption;
                    value: root.knife-text;
                    value-color: root.knife-active ? Theme.accent : Theme.text;
                    horizontal-stretch: 1;
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey {
                    key: "F1";
                    label: root.wrap-active ? root.tr.sk-wrapping : root.tr.sk-wrap;
                    highlighted: root.wrap-armed;
                    enabled: root.wrap-armed;
                }
                Softkey {
                    key: "F2";
                    label: root.knife-active ? root.tr.sk-knife-active : root.tr.sk-knife-toggle;
                }
                Softkey { key: "F3"; label: root.tr.sk-reset-session; }
                Softkey { key: "F4"; label: ""; enabled: false; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: root.tr.sk-service; }
            }
        }
    }

    // =====================================================================
    // SERVICE
    // =====================================================================
    if root.screen == Screen.service: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: root.tr.service-title; color: Theme.text; font-size: 26px; font-weight: 800; }

            Rectangle {
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.panel-edge;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: root.tr.enter-pin; color: Theme.muted; font-size: 16px; }
                    Text {
                        text: root.pin-display;
                        color: Theme.text;
                        font-size: 48px;
                        font-weight: 800;
                        letter-spacing: 12px;
                    }
                    Text {
                        text: root.tr.pin-hint;
                        color: Theme.muted;
                        font-size: 14px;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: root.ethernet-selected ? Theme.panel : Theme.accent.with-alpha(0.18);
                    border-width: 1px;
                    border-color: root.ethernet-selected ? Theme.panel-edge : Theme.accent;
                    VerticalLayout {
                        padding: 12px;
                        Text { text: root.tr.network-caption; color: Theme.muted; font-size: 13px; }
                        Text {
                            // ETHERNET / ETHERCAT are proper nouns — untranslated.
                            text: root.ethernet-selected ? "ETHERNET" : "ETHERCAT";
                            color: Theme.text; font-size: 22px; font-weight: 700;
                        }
                    }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey { key: "F1"; label: root.tr.sk-reset-total; }
                Softkey { key: "F2"; label: root.ethernet-selected ? root.tr.sk-use-ethercat : root.tr.sk-use-ethernet; }
                Softkey { key: "F3"; label: root.tr.sk-language; }
                Softkey { key: "F4"; label: ""; enabled: false; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: root.tr.sk-back; }
            }
        }
    }

    // =====================================================================
    // ETHERNET
    // =====================================================================
    if root.screen == Screen.ethernet: Rectangle {
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: root.tr.eth-title; color: Theme.accent; font-size: 26px; font-weight: 800; }

            Rectangle {
                height: 64px;
                border-radius: 8px;
                background: Theme.accent.with-alpha(0.15);
                border-width: 1px;
                border-color: Theme.accent;
                Text {
                    text: root.tr.eth-offline;
                    color: Theme.text; font-size: 22px; font-weight: 700;
                }
            }

            Rectangle {
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.panel-edge;
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text { text: root.tr.static-ip-caption; color: Theme.muted; font-size: 16px; }
                    Text { text: root.ip-text; color: Theme.text; font-size: 40px; font-weight: 800; }
                }
            }

            Rectangle { }

            HorizontalLayout {
                alignment: space-between;
                Softkey { key: "F1"; label: root.tr.sk-return-ethercat; }
                Softkey { key: "F2"; label: ""; enabled: false; }
                Softkey { key: "F3"; label: ""; enabled: false; }
                Softkey { key: "F4"; label: ""; enabled: false; }
                Softkey { key: "F5"; label: ""; enabled: false; }
                Softkey { key: "F6"; label: ""; enabled: false; }
            }
        }
    }

    // =====================================================================
    // FAULT overlay (modal)
    // =====================================================================
    if root.screen == Screen.fault: Rectangle {
        background: #000000.with-alpha(0.78);
        Rectangle {
            width: 560px;
            height: 280px;
            border-radius: 12px;
            background: Theme.panel;
            border-width: 3px;
            border-color: Theme.danger;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: center;
                Text {
                    text: root.tr.fault-title;
                    color: Theme.danger;
                    font-size: 44px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.fault-text;
                    color: Theme.text;
                    font-size: 22px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.tr.fault-detail;
                    color: Theme.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
